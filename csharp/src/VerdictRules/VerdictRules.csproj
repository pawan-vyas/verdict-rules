<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Denylist by TFM family, not an allowlist of specific versions: both
         flags are on for every modern net5.0+ target and off only for
         netstandard2.1, which has no runtime of its own to be trimmed or
         AOT-compiled with. IsTargetFrameworkCompatible checks family
         membership (net10.0, net11.0, net12.0, ... are all "compatible with"
         net5.0), so a future modern TFM lands with both already true and
         netstandard2.1 stays excluded, with zero edits to either line. A
         plain string check ('$(TargetFramework)' != 'netstandard2.1') looks
         equivalent today but is the wrong tool: it would incorrectly turn
         both on for any future non-net5+-family TFM (a hypothetical
         netstandard2.2, or a net-prefixed OS-specific TFM this package
         doesn't use), where IsTargetFrameworkCompatible correctly stays off. -->
    <IsTrimmable Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net5.0'))">true</IsTrimmable>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net5.0'))">true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>VerdictRules</PackageId>
    <Version>0.3.2</Version>
    <Authors>Pawan Vyas</Authors>
    <Description>A small, zero-dependency, async-native rule-evaluation engine. Compose conditions into one explainable pass/fail verdict, with sequential evaluation and real short-circuiting as a guarantee.</Description>
    <PackageTags>rules-engine;rule-evaluation;eligibility;decision;decision-engine;async</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/pawan-vyas/verdict-rules</PackageProjectUrl>
    <RepositoryUrl>https://github.com/pawan-vyas/verdict-rules</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- NuGet surfaces release notes from metadata rather than from a file, so
         this points at the changelog instead of duplicating it. A copy here
         would drift the moment either side changed. -->
    <PackageReleaseNotes>https://github.com/pawan-vyas/verdict-rules/blob/csharp-v0.3.2/csharp/src/VerdictRules/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <!-- A consumer stepping into this package should land on real source, not a
       decompiler. SourceLink embeds the commit and repository so the debugger
       can fetch it; the symbol package carries the PDBs. Retrofitting this
       after a release means the released versions stay undebuggable forever. -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
