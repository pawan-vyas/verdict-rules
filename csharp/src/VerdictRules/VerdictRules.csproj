<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.1</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible Condition="'$(TargetFramework)' == 'net8.0'">true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>VerdictRules</PackageId>
    <Version>0.0.1</Version>
    <Authors>Pawan Vyas</Authors>
    <Description>A small, zero-dependency, async-native rule-evaluation engine. Compose conditions into one explainable pass/fail verdict, with sequential evaluation and real short-circuiting as a guarantee.</Description>
    <PackageTags>rules-engine;rule-evaluation;eligibility;policy;decision</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/pawan-vyas/verdict-rules</PackageProjectUrl>
    <RepositoryUrl>https://github.com/pawan-vyas/verdict-rules</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- NuGet surfaces release notes from metadata rather than from a file, so
         this points at the changelog instead of duplicating it. A copy here
         would drift the moment either side changed. -->
    <PackageReleaseNotes>https://github.com/pawan-vyas/verdict-rules/blob/csharp-v0.0.1/csharp/src/VerdictRules/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <!-- A consumer stepping into this package should land on real source, not a
       decompiler. SourceLink embeds the commit and repository so the debugger
       can fetch it; the symbol package carries the PDBs. Retrofitting this
       after a release means the released versions stay undebuggable forever. -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
