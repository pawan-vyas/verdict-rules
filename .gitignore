# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Build artifacts
dist/
build/

# Virtual environments
.venv/
venv/

# Editor/OS
.DS_Store
# .vscode/ stays ignored for personal editor state (launch configs, per-user
# overrides) -- settings.json is the one exception, committed deliberately
# for fixes that belong to every contributor, not this machine.
.vscode/*
!.vscode/settings.json
.idea/

# Skill eval loop working material — see skills/verdict-workspace/.gitignore
# for the specific rule (only evals/evals.json is tracked, everything else
# there is point-in-time, regenerable working output).

# Transient agent working material — throwaway docs, logs, scripts,
# research notes, anything that stops mattering once it has been read.
# Kept inside .agents/ so every agent writes it to one known place
# instead of a harness-specific temp dir, but untracked because it is
# working material, not part of the repo. Durable notes never land
# here; they go in AGENTS.md / HANDOFF.md / .agents/memory/ / .agents/plans/.
.agents/scratch/

# Harness config: the project-scope, shareable parts are committed
# (they record this repo's toolchain), the personal/machine-local ones
# are not.
.claude/settings.local.json
*.local.json

# SDK build output and local tool caches, for every language directory.
# These live here rather than on each SDK's own branch: a branch whose
# .gitignore lacks another language's rules will sweep that language's build
# output into a commit the moment anyone runs `git add -A` with both checked
# out. That has already happened once.
js/node_modules/
js/packages/*/dist/
js/*.tgz
dart/.dart_tool/
dart/.packages
dart/pubspec.lock
dart/build/
# Dart commands run from inside each package directory (see dart/AGENTS.md --
# there is deliberately no root pubspec.yaml yet), so .dart_tool/ actually
# lands under packages/<name>/, not the workspace root. This pattern leaked
# into a commit three times this session before catching that the rule above
# never matched where the artifact was really created.
dart/packages/*/.dart_tool/
dart/packages/*/.packages
dart/packages/*/pubspec.lock
dart/packages/*/build/
# Same leak, same fix, for dart/examples/ -- a standalone example package
# (its own pubspec.yaml, a path: dependency on verdict_rules) rather than a
# pub workspace member, for the same reason noted above.
dart/examples/*/.dart_tool/
dart/examples/*/.packages
dart/examples/*/pubspec.lock
dart/examples/*/build/
# skills/verdict-workspace/evals/dart/files/ ships a real pubspec.yaml as an
# eval fixture -- committing its pubspec.lock is deliberate (the eval itself
# reads it), but a fourth instance of the same leak above: something in this
# environment auto-runs `dart pub get` the moment a pubspec.yaml appears
# anywhere, regenerating .dart_tool/ wherever one exists, not just under
# dart/packages/.
skills/verdict-workspace/evals/*/files/.dart_tool/
csharp/**/bin/
csharp/**/obj/
# Same leak as the Dart eval-fixture case above, for C#: files/StorefrontApi.csproj
# ships as a real eval fixture, but dotnet build/restore against it regenerates
# bin/obj outside csharp/**, which the pattern above doesn't reach.
skills/verdict-workspace/evals/*/files/bin/
skills/verdict-workspace/evals/*/files/obj/
